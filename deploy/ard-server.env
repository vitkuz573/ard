# ard-server configuration.
#
# ARD_DEVICES is the device allowlist. It is required and has no default: a gateway
# that accepted any device presenting any certificate would be an open relay onto
# every phone that trusts it. List device UUIDs explicitly, one allowlist entry per
# enrolled device.
#
# ARD_LISTEN_DEVICES must stay bound to the public interface: devices dial in.
# ARD_LISTEN_OPERATORS likewise. Neither port exposes ADB itself, only
# mutually-authenticated TLS whose peer role is fixed by certificate root.
ARD_LISTEN_DEVICES=:7000
ARD_LISTEN_OPERATORS=:7100

# Enrolment. This is the only listener that accepts a peer with no client certificate,
# because a device has none until it is enrolled. It cannot issue anything: requests are
# stored and a human holding the CA signs them over the control socket, which requires
# uid 0. ARD_ENROL_TTL is how long a request waits for that human.
ARD_LISTEN_ENROL=:7200
ARD_ENROL_TTL=15m

ARD_CONTROL_SOCKET=/run/ard/control.sock
ARD_PKI_DIR=/etc/ard/pki
ARD_OPERATORS_FILE=/etc/ard/operators.yaml
ARD_AUDIT_LOG=/var/log/ard/audit.log

# Comma-separated, no spaces.
ARD_DEVICES=CHANGE-ME-device-uuid
